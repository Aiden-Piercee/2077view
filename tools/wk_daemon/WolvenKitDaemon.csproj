      <HintPath>..\wolvenkit\WolvenKit.RED4.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Hosting.Abstractions">
      <HintPath>..\wolvenkit\Microsoft.Extensions.Hosting.Abstractions.dll</HintPath>
